PRAGMA foreign_keys = ON;

CREATE TABLE persona (
    codigo_persona TEXT PRIMARY KEY,
    nombre         TEXT NOT NULL,
    apellido       TEXT NOT NULL,
    dpi            TEXT NOT NULL UNIQUE,
    telefono       TEXT,
    correo         TEXT,
    direccion      TEXT,
    estado         TEXT NOT NULL DEFAULT 'Activo'
);

CREATE TABLE cliente (
    codigo_persona TEXT PRIMARY KEY REFERENCES persona(codigo_persona),
    nit            TEXT NOT NULL UNIQUE,
    saldo          NUMERIC NOT NULL DEFAULT 0
);

CREATE TABLE empleado (
    codigo_persona  TEXT PRIMARY KEY REFERENCES persona(codigo_persona),
    rol             TEXT NOT NULL,
    sueldo          NUMERIC NOT NULL CHECK (sueldo >= 0),
    usuario         TEXT NOT NULL UNIQUE,
    contrasena_hash TEXT NOT NULL
);

CREATE TABLE vehiculo (
    codigo_vehiculo TEXT PRIMARY KEY,
    codigo_cliente  TEXT NOT NULL REFERENCES cliente(codigo_persona),
    placa   TEXT NOT NULL UNIQUE,
    marca   TEXT,
    modelo  TEXT,
    tipo    TEXT,
    color   TEXT,
    anio    INTEGER CHECK (anio BETWEEN 1950 AND 2100),
    estado  TEXT NOT NULL DEFAULT 'Activo'
);

CREATE TABLE servicio (
    codigo_servicio TEXT PRIMARY KEY,
    nombre       TEXT NOT NULL,
    categoria    TEXT,
    costo        NUMERIC NOT NULL CHECK (costo >= 0),
    descripcion  TEXT,
    duracion_min INTEGER CHECK (duracion_min > 0)
);

CREATE TABLE repuesto (
    codigo_repuesto TEXT PRIMARY KEY,
    nombre       TEXT NOT NULL,
    descripcion  TEXT,
    categoria    TEXT,
    marca        TEXT,
    precio       NUMERIC NOT NULL CHECK (precio >= 0),
    existencias  INTEGER NOT NULL DEFAULT 0 CHECK (existencias >= 0),
    estado       TEXT NOT NULL DEFAULT 'Activo'
);

CREATE TABLE cita (
    codigo_cita     TEXT PRIMARY KEY,
    codigo_cliente  TEXT NOT NULL REFERENCES cliente(codigo_persona),
    codigo_vehiculo TEXT NOT NULL REFERENCES vehiculo(codigo_vehiculo),
    codigo_tecnico  TEXT NOT NULL REFERENCES empleado(codigo_persona),
    fecha_hora      TEXT NOT NULL,   -- 'YYYY-MM-DD HH:MM:SS'
    estado          TEXT NOT NULL DEFAULT 'Pendiente',
    observaciones   TEXT
);

CREATE TABLE cita_servicio (
    codigo_cita     TEXT REFERENCES cita(codigo_cita) ON DELETE CASCADE,
    codigo_servicio TEXT REFERENCES servicio(codigo_servicio),
    PRIMARY KEY (codigo_cita, codigo_servicio)
);

CREATE TABLE factura (
    codigo_factura TEXT PRIMARY KEY,
    codigo_cita    TEXT NOT NULL UNIQUE REFERENCES cita(codigo_cita),
    fecha          TEXT NOT NULL DEFAULT (datetime('now','localtime')),
    descuento      NUMERIC NOT NULL DEFAULT 0,
    total          NUMERIC NOT NULL
);

CREATE TABLE factura_servicio (
    codigo_factura  TEXT REFERENCES factura(codigo_factura) ON DELETE CASCADE,
    codigo_servicio TEXT REFERENCES servicio(codigo_servicio),
    precio          NUMERIC NOT NULL,
    PRIMARY KEY (codigo_factura, codigo_servicio)
);

CREATE TABLE factura_repuesto (
    codigo_factura  TEXT REFERENCES factura(codigo_factura) ON DELETE CASCADE,
    codigo_repuesto TEXT REFERENCES repuesto(codigo_repuesto),
    cantidad        INTEGER NOT NULL CHECK (cantidad > 0),
    precio_unitario NUMERIC NOT NULL,
    PRIMARY KEY (codigo_factura, codigo_repuesto)
);

CREATE INDEX idx_cita_fecha   ON cita(fecha_hora);
CREATE INDEX idx_cita_tecnico ON cita(codigo_tecnico);
CREATE INDEX idx_vehiculo_cli ON vehiculo(codigo_cliente);